# ---------------------------------------------------------------
# AI Backend (FastAPI)  —  Backend/.env
# Copy to ".env" and fill in YOUR values. Never commit the real .env.
# ---------------------------------------------------------------

# Supabase Postgres. Use the SESSION POOLER string from
# Supabase > Project Settings > Database > Connection string > Session pooler
# (URL-encode the password if it contains @ : / ? # [ ] or %)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# JWT — MUST be byte-for-byte identical to JWT_SECRET in the auth server,
# otherwise tokens issued by the auth server will not verify here.
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=<paste-generated-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=172800

# App settings
APP_NAME=Construction Safety Monitor
VERSION=1.0.0
YOLO_MODEL_PATH=yolo_models/yolo11n.pt

# CORS — JSON array. Add every origin the frontend is served from.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
