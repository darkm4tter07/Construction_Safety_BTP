# ---------------------------------------------------------------
# Frontend (React + Vite)  —  Frontend/.env
# Copy to ".env" and fill in YOUR values.
# Anything named VITE_* is bundled into the public JS. Never put a
# Supabase service_role key or any server secret in here.
# ---------------------------------------------------------------

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# --- NOT READ BY THE APP YET. ---
# The service URLs live in src/Constant.js and src/store/wsStore.js, and the
# weather key in src/hooks/useWeather.js. They are listed here as a record of
# what is configurable; edit those files directly (see README step 5).
# VITE_AUTH_URL=http://localhost:3000
# VITE_AI_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws
# VITE_OPENWEATHER_KEY=<openweathermap-api-key>
