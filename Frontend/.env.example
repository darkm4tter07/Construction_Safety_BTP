# ---------------------------------------------------------------
# Frontend (React + Vite)  —  Frontend/.env
# Copy to ".env" and fill in YOUR values.
# Anything named VITE_* is bundled into the public JS. Never put a
# Supabase service_role key or any server secret in here.
# ---------------------------------------------------------------

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# --- The three below are currently HARDCODED in src/Constant.js,
# --- src/store/wsStore.js and src/hooks/useWeather.js.
# --- See Part 7 of the handover guide for the small edits that move
# --- them here. Until then these are ignored.
VITE_AUTH_URL=http://localhost:3000
VITE_AI_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_OPENWEATHER_KEY=<openweathermap-api-key>
